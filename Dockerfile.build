FROM python:3.11-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    unzip \
    xz-utils \
    file \
    clang \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    liblzma-dev \
    libstdc++-12-dev \
    libsecret-1-dev \
    libmpv-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Baixa e extrai o appimagetool para rodar sem FUSE no Docker
RUN curl -fSL "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage" -o /tmp/appimagetool.AppImage \
    && chmod +x /tmp/appimagetool.AppImage \
    && cd /tmp && ./appimagetool.AppImage --appimage-extract \
    && mv /tmp/squashfs-root /opt/appimagetool \
    && rm /tmp/appimagetool.AppImage

RUN pip install --no-cache-dir "flet>=0.80.0"

WORKDIR /build
COPY pyproject.toml .
COPY src ./src
COPY build_appimage.sh .
RUN chmod +x build_appimage.sh

CMD ["./build_appimage.sh"]